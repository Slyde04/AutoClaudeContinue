{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoClaudeContinue",
  "version": "1.2.0",
  "identifier": "com.kutaos.autoclaudecontinue",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoClaudeContinue",
        "width": 1080,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/acc-backend"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
